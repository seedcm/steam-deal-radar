{
  "name": "@radar/desktop",
  "version": "1.3.2",
  "private": true,
  "description": "Steam 折扣雷达 桌面版 (Windows / Linux)",
  "author": "Steam Deal Radar",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "dev": "node scripts/build-main.mjs && electron . --dev",
    "start": "electron .",
    "dist:dir": "node scripts/build-main.mjs && electron-builder --dir",
    "dist:linux": "node scripts/build-main.mjs && electron-builder --linux",
    "dist:win": "node scripts/build-main.mjs && electron-builder --win",
    "dist:linux:deb": "node scripts/build-main.mjs && electron-builder --linux AppImage deb",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.0",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0",
    "electron-updater": "6.8.11"
  },
  "homepage": "https://github.com/seedcm/steam-deal-radar",
  "desktopName": "steam-deal-radar.desktop"
}
